{
  "name": "statable-analytics",
  "version": "0.1.0",
  "description": "Add Statable privacy-first web analytics to an Astro or Vite site with one line of config. Cookieless, no consent banner for your analytics, EU-hosted.",
  "keywords": [
    "astro-integration",
    "withastro",
    "vite-plugin",
    "analytics",
    "web-analytics",
    "statable",
    "privacy",
    "cookieless",
    "google-analytics-alternative"
  ],
  "license": "MIT",
  "homepage": "https://statable.com/docs/install/astro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/key-arg/statable-analytics.git"
  },
  "bugs": "https://github.com/key-arg/statable-analytics/issues",
  "author": {
    "name": "Key Arg B.V.",
    "email": "support@statable.com",
    "url": "https://statable.com"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
